PORT=5000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
FRONTEND_URL=https://YOUR-NETLIFY-SITE.netlify.app
ALLOWED_ORIGINS=https://YOUR-NETLIFY-SITE.netlify.app,http://localhost:5500,http://127.0.0.1:5500
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DB_SSL=false
NODE_ENV=production

# Railway MySQL variables can also be used directly instead of DB_*:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
